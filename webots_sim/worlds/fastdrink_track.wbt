#VRML_SIM R2025a utf8

EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/9292d077c7d342ede14a54df3f74c16f2bcb8d12/projects/objects/backgrounds/protos/TexturedBackground.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/9292d077c7d342ede14a54df3f74c16f2bcb8d12/projects/objects/backgrounds/protos/TexturedBackgroundLight.proto"
EXTERNPROTO "https://raw.githubusercontent.com/cyberbotics/webots/9292d077c7d342ede14a54df3f74c16f2bcb8d12/projects/objects/floors/protos/RectangleArena.proto"

WorldInfo {
  info [
    "Simulation Webots pour PiCar FastDrink S5-GI",
    "Châssis Ackermann 1:1, vraie bille physique 3D et régulation a <= 0.735 m/s²"
  ]
  title "FastDrink PiCar World"
  basicTimeStep 10
  contactProperties [
    ContactProperties {
      material1 "cup_mat"
      material2 "ball_mat"
      coulombFriction [ 0.25 ]
      bounce 0.1
      rollingFriction 0.002 0 0
    }
    ContactProperties {
      material1 "tire_mat"
      material2 "floor_mat"
      coulombFriction [ 0.85 ]
    }
    ContactProperties {
      material1 "tire_mat"
      material2 "default"
      coulombFriction [ 0.85 ]
    }
    ContactProperties {
      material1 "ball_mat"
      material2 "default"
      coulombFriction [ 0.2 ]
      bounce 0.3
    }
  ]
}

# Vue caméra qui suit automatiquement le PiCar
Viewpoint {
  orientation 0.28 0.72 -0.62 0.95
  position -1.2 0.8 1.1
  follow "picar"
}

# Ciel et lumière
TexturedBackground {
}
TexturedBackgroundLight {
}

# Arène officielle 2.2m x 2.2m avec sol blanc uniforme (sans damier)
RectangleArena {
  floorSize 2.2 2.2
  floorTileSize 2.2 2.2
  floorAppearance PBRAppearance {
    baseColor 0.95 0.95 0.95
    roughness 0.3
    metalness 0.0
  }
  wallHeight 0.05
}

# ==============================================================================
# Piste : Circuit complet 18 mm (Mesh track_circuit.obj)
# ==============================================================================
Solid {
  translation 0 0 0.0005
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.02 0.02 0.02
        roughness 0.2
        metalness 0.0
      }
      geometry Mesh {
        url [ "../meshes/track_circuit.obj" ]
      }
    }
  ]
  name "track_tape"
  boundingObject Mesh {
    url [ "../meshes/track_circuit.obj" ]
  }
}

# ==============================================================================
# Bille en acier libre (RigidBody 3D) - Mesh Blender bille.blend
# ==============================================================================
DEF BALL Solid {
  translation -0.50 -0.6585 0.083
  children [
    Shape {
      appearance PBRAppearance {
        baseColor 0.9 0.9 0.95
        metalness 0.95
        roughness 0.15
      }
      geometry Mesh {
        url [ "../meshes/bille.obj" ]
      }
    }
  ]
  name "fastdrink_ball"
  contactMaterial "ball_mat"
  boundingObject Sphere {
    radius 0.009
  }
  physics Physics {
    density -1
    mass 0.015
  }
}

# ==============================================================================
# Robot PiCar avec Direction d'Ackermann 1:1 - Modèle 3D robot.blend
# ==============================================================================
Robot {
  translation -0.50 -0.60 0.032
  supervisor TRUE
  children [
    # Châssis principal (Modèle 3D Blender robot.blend)
    Transform {
      translation 0 0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.15 0.35 0.85
            roughness 0.4
          }
          geometry Mesh {
            url [ "../meshes/chassis.obj" ]
          }
        }
      ]
    }

    # Coupelle FastDrink (Modèle 3D Blender PiCarFrame3_V2b)
    Transform {
      translation 0 0 0
      children [
        Shape {
          appearance PBRAppearance {
            baseColor 0.80 0.80 0.85
            metalness 0.7
            roughness 0.25
          }
          geometry Mesh {
            url [ "../meshes/cup_frame.obj" ]
          }
        }
      ]
    }

    # Capteur Ultrason HC-SR04 (face avant +Y)
    DistanceSensor {
      translation 0 0.110 0.02
      rotation 0 0 1 1.570796
      name "ultrasonic"
      lookupTable [
        0 0 0
        4.0 400 0
      ]
      type "sonar"
      numberOfRays 3
      aperture 0.5
    }

    # 5 Capteurs infrarouges de sol TCRT5000 (espacement physique réel 14 mm avec chevauchement optique)
    DistanceSensor {
      translation -0.028 0.105 -0.015
      rotation 0 1 0 1.570796
      name "ir_g2"
      lookupTable [ 0 1000 0, 0.05 0 0 ]
      type "infra-red"
    }
    DistanceSensor {
      translation -0.014 0.105 -0.015
      rotation 0 1 0 1.570796
      name "ir_g1"
      lookupTable [ 0 1000 0, 0.05 0 0 ]
      type "infra-red"
    }
    DistanceSensor {
      translation 0.0 0.105 -0.015
      rotation 0 1 0 1.570796
      name "ir_c"
      lookupTable [ 0 1000 0, 0.05 0 0 ]
      type "infra-red"
    }
    DistanceSensor {
      translation 0.014 0.105 -0.015
      rotation 0 1 0 1.570796
      name "ir_d1"
      lookupTable [ 0 1000 0, 0.05 0 0 ]
      type "infra-red"
    }
    DistanceSensor {
      translation 0.028 0.105 -0.015
      rotation 0 1 0 1.570796
      name "ir_d2"
      lookupTable [ 0 1000 0, 0.05 0 0 ]
      type "infra-red"
    }

    # --------------------------------------------------------------------------
    # Train Arrière Moteur (Propulsion)
    # --------------------------------------------------------------------------
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor -0.068 -0.065 0
      }
      device [
        RotationalMotor {
          name "rear_left_motor"
        }
      ]
      endPoint Solid {
        name "rear_left_wheel"
        translation -0.068 -0.065 0
        rotation 0 1 0 1.5708
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 }
            geometry Cylinder { height 0.022 radius 0.032 }
          }
        ]
        contactMaterial "tire_mat"
        boundingObject Cylinder { height 0.022 radius 0.032 }
        physics Physics { density -1 mass 0.06 }
      }
    }
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 1 0 0
        anchor 0.068 -0.065 0
      }
      device [
        RotationalMotor {
          name "rear_right_motor"
        }
      ]
      endPoint Solid {
        name "rear_right_wheel"
        translation 0.068 -0.065 0
        rotation 0 1 0 1.5708
        children [
          Shape {
            appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 }
            geometry Cylinder { height 0.022 radius 0.032 }
          }
        ]
        contactMaterial "tire_mat"
        boundingObject Cylinder { height 0.022 radius 0.032 }
        physics Physics { density -1 mass 0.06 }
      }
    }

    # --------------------------------------------------------------------------
    # Train Avant Directeur (Servomoteurs d'Ackermann)
    # --------------------------------------------------------------------------
    # Pivot de direction avant-gauche
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor -0.065 0.065 0
      }
      device [
        RotationalMotor {
          name "left_steer_servo"
          minPosition -0.785398
          maxPosition 0.785398
        }
      ]
      endPoint Solid {
        name "left_steer_hub"
        translation -0.065 0.065 0
        children [
          # Axe de rotation de la roue avant-gauche
          HingeJoint {
            jointParameters HingeJointParameters {
              axis 1 0 0
              anchor -0.003 0 0
            }
            endPoint Solid {
              name "front_left_wheel"
              translation -0.003 0 0
              rotation 0 1 0 1.5708
              children [
                Shape {
                  appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 }
                  geometry Cylinder { height 0.022 radius 0.032 }
                }
              ]
              contactMaterial "tire_mat"
              boundingObject Cylinder { height 0.022 radius 0.032 }
              physics Physics { density -1 mass 0.05 }
            }
          }
        ]
        boundingObject Box { size 0.01 0.01 0.01 }
        physics Physics { density -1 mass 0.02 }
      }
    }

    # Pivot de direction avant-droit
    HingeJoint {
      jointParameters HingeJointParameters {
        axis 0 0 1
        anchor 0.065 0.065 0
      }
      device [
        RotationalMotor {
          name "right_steer_servo"
          minPosition -0.785398
          maxPosition 0.785398
        }
      ]
      endPoint Solid {
        name "right_steer_hub"
        translation 0.065 0.065 0
        children [
          # Axe de rotation de la roue avant-droite
          HingeJoint {
            jointParameters HingeJointParameters {
              axis 1 0 0
              anchor 0.003 0 0
            }
            endPoint Solid {
              name "front_right_wheel"
              translation 0.003 0 0
              rotation 0 1 0 1.5708
              children [
                Shape {
                  appearance PBRAppearance { baseColor 0.1 0.1 0.1 roughness 0.9 }
                  geometry Cylinder { height 0.022 radius 0.032 }
                }
              ]
              contactMaterial "tire_mat"
              boundingObject Cylinder { height 0.022 radius 0.032 }
              physics Physics { density -1 mass 0.05 }
            }
          }
        ]
        boundingObject Box { size 0.01 0.01 0.01 }
        physics Physics { density -1 mass 0.02 }
      }
    }
  ]

  name "picar"
  contactMaterial "cup_mat"
  # Boîte de collision du châssis + coupelle concave
  boundingObject Group {
    children [
      Transform {
        translation 0 -0.02 0.025
        children [
          Box { size 0.10 0.20 0.03 }
        ]
      }
      Transform {
        translation 0 -0.0585 0.040
        children [
          Cylinder { height 0.006 radius 0.022 }
        ]
      }
      Transform {
        translation 0 -0.0385 0.046
        children [ Box { size 0.04 0.004 0.012 } ]
      }
      Transform {
        translation 0 -0.0785 0.046
        children [ Box { size 0.04 0.004 0.012 } ]
      }
      Transform {
        translation 0.020 -0.0585 0.046
        children [ Box { size 0.004 0.04 0.012 } ]
      }
      Transform {
        translation -0.020 -0.0585 0.046
        children [ Box { size 0.004 0.04 0.012 } ]
      }
    ]
  }
  physics Physics {
    density -1
    mass 0.70
  }
  controller "picar_webots"
}
