#!/bin/sh
# /etc/init.d/S80picar_sensors
# Script de supervision SysVinit pour le service capteurs PiCar

DAEMON="/root/picar_sensors"
NAME="picar_sensors"
PIDFILE="/var/run/${NAME}.pid"
DAEMON_ARGS="--hz 50"

case "$1" in
    start)
        echo "Démarrage du service $NAME..."
        start-stop-daemon -S -b -m -p "$PIDFILE" -x "$DAEMON" -- $DAEMON_ARGS
        ;;
    stop)
        echo "Arrêt du service $NAME..."
        start-stop-daemon -K -p "$PIDFILE" -s SIGTERM
        rm -f "$PIDFILE"
        ;;
    restart)
        $0 stop
        sleep 1
        $0 start
        ;;
    *)
        echo "Usage: $0 {start|stop|restart}"
        exit 1
        ;;
esac

exit 0
